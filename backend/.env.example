# ===========================================
# GROQ API - LLM Provider
# Get FREE API key: https://console.groq.com/keys
# ===========================================
GROQ_API_KEY=your_groq_api_key_here

# Groq models: llama-3.1-8b-instant (fast), llama-3.1-70b-versatile (smarter), mixtral-8x7b-32768
LLM_MODEL=llama-3.1-8b-instant

# ===========================================
# NEON - PostgreSQL + pgvector
# Get FREE account: https://neon.tech
# Free tier: 0.5 GB storage, scales to zero (wakes automatically)
# ===========================================
DATABASE_URL=postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# ===========================================
# JINA AI - Embeddings API (Recommended)
# Docs: https://jina.ai/embeddings/
# Free tier: 10,000 requests/day (no key required!)
# Get API key for higher limits: https://jina.ai/embeddings/
# ===========================================
JINA_API_KEY=your-jina-api-key-optional

# ===========================================
# SYSTEM CONFIGURATION (Optional)
# ===========================================
SYSTEM_PROMPT=You are a helpful assistant. Keep answers concise and clear.

# RAG Configuration
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.3
